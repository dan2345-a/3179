{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Heat map of international visitors arriving in Australia each month.",
    "width": 400,
    "data": {"url": "data/visitor_arrivals.csv"},
    "encoding": {
        "x" : {
            "field" : "mon",
            "type" : "ordinal",
            "sort": [
                "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct",
        "Nov", "Dec"

            ],

            "title" : null,
            "axis" : {
                "labelAngle" : 0,
                "orient" : "top",
                "domain": false,
                "ticks": false

            }
        }, 
        "y": {
            "field" : "year",
            "type" : "ordinal",
            "title" : null,
            "axis" : {"domain" : false, "ticks" : false}
        }
    }, 
    "layer" : [
        {
            "mark" : {
                "type" : "rect",
                "cornerRadius": 4,
                "stroke" : "#ffffff",
                "strokeWidth" : 2
            },
            "encoding": {
                "color" : {
                    "field" : "arrivals",
                    "type": "quantitative",
                    "title" : "Visitors arriving in each month",
                    "scale": {
            "range": ["#EAF1F7", "#B3CBE0", "#6A97BD", "#2F6690", "#16324F"]
          },  
          "legend" : {
            "orient" : "bottom",
            "gradientLength" : 200,
            "format": "~s",
            "titleLimit" :200
          }
                },
                "tooltip" : [
                    {
                    "field": "date",
                    "type": "temporal",
                    "timeUnit": "yearmonth",
                    "title": "Month",
                    "format": "%B %Y"

                },
                {
                    "field": "arrivals",
                    "type": "quantitative",
                    "title": "Visitors arriving",
                    "format": ","

                }
                    
                ]
                
            }
        }
        
        
            
        
    ]
}