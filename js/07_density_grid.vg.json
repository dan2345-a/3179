{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Small multiples of gridded density maps : sharing of each animal sightings in each square",
   
    
    "width": 560,
    "height": 470,
    "params": [
        {
            "name": "Hotspot_animal",
            "value" : "Koala",
            "bind" : {
                "input": "select",
                "options": ["Koala", "Eastern grey kangaroo", "Platypus", "Saltwater crocodile", "Quokka", "Tasmanian devil", "Little penguin"],
                "name" : "Animal: "
        }
    }
    ],
    "projection": {
        "type": "conicEqualArea",
        "parallels" : [-18, -36],
        "rotate": [-132, 0]
    },
        "layer": [
            {
                "data" : {
                    "url": "data/aus_states.topo.json",
                    "format" : {"type" : "topojson", "feature" : "states"}

                },
                "mark" : {
                    "type": "geoshape",
                    "fill" : "#E1ECEC",
                    "stroke" : "#ffffff",
                    "strokeWidth" : 1
                }
            },
            {
                "data" : {"url" : "data/land_cells.csv"},
                "mark" : {"type" : "square", "size" : 150, "color" : "#D3DEE0", "stroke": "#ffffff" , "strokeWidth" : 0.6},
                "encoding": {
                    "longitude" : {"field": "lon", "type" : "quantitative"},
                    "latitude" : {"field": "lat", "type" : "quantitative"},
                    "tooltip" : 
                        {"value": "No sightings of the animals in this square" }
                    

                }
            },
            {
                "data" : {"url" : "data/sighting_grid.csv"},
                "transform": [{"filter": "datum.species == Hotspot_animal"}],
                "mark" : { "type" : "square", "size" : 150 , "stroke": "#ffffff", "strokeWidth": 0.6},
                "encoding": {
                    "longitude" : {"field": "lon", "type" : "quantitative"},
                    "latitude" : {"field": "lat", "type" : "quantitative"},
                    "color" : {
                        "field" : "share", 
                        "type": "quantitative",
                        "title": "Share of the animals's sightings",
                        "scale" : {
                            "type": "sqrt",
                            "range" : ["#FFF0EC", "#FFC2B5", "#FF8A73", "#E5533D", "#9E2A1B"]
                        },
                        "legend" : {
                            "format" : ".0%",
                            "orient": "bottom",
                            "gradientLength" : 200,
                            "titleLimit": 260
                        }
                    },
                    "tooltip" : [
                        {"field": "species" , "type" : "nominal" , "title": "Animal"},
                        {"field": "share_txt" , "type" : "nominal" , "title": "Share of sightings here"},
                        {"field": "count" , "type" : "quantitative" , "title": "Records in this square"},
                        {"field": "rank_txt" , "type" : "nominal" , "title": "Hotspot rank"},
                        {"field": "where_txt" , "type" : "nominal" , "title": "Square centre"}
                    ]
                }
            }

        ],
    
    "config": {
        "view": {"stroke" : null}
    }


}
