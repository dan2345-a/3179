{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Choropleth of the share of each state's land that is protected",
    "hconcat": [
        {
            "width" : 420,
            "height" : 380 ,
            "projection": {
                "type": "conicEqualArea",
                "parallels" : [0, -36],
                "rotate" : [-132, 0]
            },
            "layer": [
                
                {
                    "data" : {
                        "url" : "data/aus_states.topo.json",
                        "format" : { "type": "topojson", "feature": "states"}
                    },
                    "transform": [
                        {"calculate": "datum.properties.name" , "as": "state"},
                        {
                            "lookup": "state",
                            "from" : {
                                "data" : {"url": "data/protected_by_state.csv"},
                                "key": "state",
                                "fields": [
                                    "pct_protected", "prot_txt", "n_national_parks", "n_areas",
                                 "visitors_last_year"
                                ]
                            }
                        },
                        {"calculate": "'Click to see its parks on the right'" , "as" : "hint"}
                    ],
                    "params": [
                        {
                            "name": "State_selection",
                            "select" : {"type": "point", "fields": ["state"]}
                        }
                    ],
                    "mark" : {
                        "type" : "geoshape",
                        "stroke" : "#ffffff",
                        "strokeWidth": 1.2,
                        "cursor": "pointer"
                    },
                    "encoding": {
                        "color" : {
                            "field" : "pct_protected",
                            "type": "quantitative",
                            "title" : "% of land protected",
                            "scale": {
                                "type" : "threshold",
                                "domain" : [10,20,30,40],
                                "range" :  ["#E3F4F4", "#9ED8D8", "#3FB3B9", "#0E8291", "#0B3C49"]
                            },
                            "legend" : {
                                "orient": "none",
                                "legendX": 0,
                                "legendY" : 318,
                                "direction": "horizontal",
                                "titleLimit":200
                            }
                        },
                        "stroke": {
                            "condition" : {
                                "param": "State_selection",
                                "empty": false,
                                "value": "#10262C"
                            },
                            "value": "#ffffff"
                        },
                        "strokeWidth": {
                            "condition": {
                                "param": "State_selection",
                                "empty": false,
                                "value" : 3
                            },
                            "value" : 1
                        },
                        "tooltip" : [
                            {"field" : "state", "type": "nominal" , "title" : "State"},
                            {"field" : "prot_txt", "type": "nominal" , "title" : "Land protected"},
                            {"field" : "n_national_parks", "type": "quantitative" , "title" : "National parks"},
                            {"field" : "n_areas", "type": "quantitative" , "title" : "All protected areas", "format": ","},
                            {"field" : "visitors_last_year", "type": "quantitative" , "title" : "Visitor staying here (2025)", "format" :","},
                            {"field" : "hint", "type": "nominal" , "title" : "Tip"}
                        ]
                    }
                },
                {
                    "data" : {"url" : "data/state_labels.csv"},
                    "mark" : {
                        "type": "text",
                        "fontSize": 11,
                        "fontWeight": "bold",
                        "color": "#10262C"
                    },
                    "encoding": {
                        "longitude" : {"field": "lon", "type": "quantitative"},
                         "latitude" : {"field": "lat", "type": "quantitative"},
                         "text" : {"field": "label"}

                    }
                }
            ]
        },
        {
            "width": 380,
            "height": 330,
            "data" : {"url": "data/national_parks.csv"},
            "layer" : [
                {
                    "mark" : { "type": "bar", "color": "#D5E0E2", "cornerRadiusEnd": 3},
                    "encoding": {
                        "x" : {
                            "field" : "size_band",
                            "type" : "ordinal",
                            "sort" : [
                                "1-10 ha", "10-100", "100-1k", "1k-10k", "10k-100k", "100k-1M", "1M+ ha"
                            ],
                            "title" : "Park size (hectares)",
                            "axis" : {"labelAngle": 0}
                        },
                        "y": {
                            "aggregate" : "count",
                            "type": "quantitative",
                            "title" : "Number of national parks"
                        },
                        "tooltip" : [
                            {"field": "size_txt" , "type": "nominal", "title": "Park size"},
                            {"aggregate": "count", "type": "quantitative", "title": "National parks in Australia"}
                        ]
                    }
                },
                {
                    "transform": [{ "filter" : {"param": "State_selection"}}],
                    "mark" : { "type": "bar", "color" : "#0E9AA7", "cornerRadiusEnd": 3},
                    "encoding": {
                        "x" : {
                            "field" : "size_band",
                            "type" : "ordinal",
                            "sort" : [
                                "1-10 ha", "10-100", "100-1k", "1k-10k", "10k-100k", "100k-1M", "1M+ ha"
                            ],
                            "title" : "Park size (hectares)",
                            "axis" : {"labelAngle": 0}
                        },
                        "y": {
                            "aggregate" : "count",
                            "type": "quantitative",
                            "title" : "Number of national parks"
                        },
                        "tooltip" : [
                            {"field": "size_txt" , "type": "nominal", "title": "Park size"},
                            {"aggregate": "count", "type": "quantitative", "title": "National parks shown"}
                        ]
                    }
                }







            ]
        }
    ],
    "config": {
        "view": {"stroke": null}
    }
}