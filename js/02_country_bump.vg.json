{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Bump chart : Rank of the top 10 visitor countries of 2025",
    "width": 330,
    "height": 300, 
    "data" : {"url": "data/country_rank.csv"},
    "transform": [{"filter": "datum.year != 2020 && datum.year != 2021"}],
    "encoding" : {
        "x" : {
            "field": "year",
            "type": "quantitative",
            "title" : null,
            "scale" : {"domain" : [2015, 2025], "nice" : false},
            "axis": {
                "format" : "d",
                "values" : [2015, 2017, 2019, 2022, 2025],
                "grid": false,
                "domain" : false, 
                "ticks": false,
                "labelFontWeight": "bold"
            }
        },
        "y": {
            "field": "rank",
            "type" : "quantitative",
            "title" : "Rank (1= most visitors)",
            "scale" : {"domain": [1,16], "reverse":true, "nice": false},
            "axis" : {
                "values" : [1,5,10,15],
                "grid": false,
                "domain": false,
                "ticks": false
            }
        }
    },
    "layer": [
        {
            "data" : {"values" : [{"start" : 2019.3 , "end": 2021.7}]},
            "mark" : {"type": "rect" , "color": "#EEF3F4" },
            "encoding" : {
                "x" : {"field": "start", "type" : "quantitative"},
                "x2" : {"field" : "end"},
                "y" : { "value": 0},
                "y2" : {"value": 300}
            }
        },
        {
            "mark": {"type": "line" , "interpolate": "monotone"},
            "params": [
                {
                    "name": "Country_hover",
                    "select": {
                        "type": "point",
                        "fields": ["country"],
                        "on": "pointerover",
                        "clear" : "pointerout"
                    }
                }
            ],
            "encoding": {
                "detail" : {"field" : "country"},
                "color": {
                    "field" : "country","type" : "nominal",
                    "scale" : {

                    "domain": ["Malaysia","New Zealand","China","United Kingdom","USA","India","Singapore","Japan","South Korea","Hong Kong","Indonesia"],
                    "range":  ["#1B3A5C","#E15759","#F28E2B","#C9A227","#59A14F","#499894","#B07AA1","#FF9DA7","#9C755F","#79A8D6","#8A8A3D"]
                        
                    },
                    "legend" : null
                },
                "strokeWidth" : {
                    "condition" : { "test" : "datum.country == 'Malaysia' " , "value" : 4.5},
                    "value" : 2
                }
            }

        },
        {
            "mark" : {
                "type": "circle",
                "size" : 55,
                "stroke" : "#ffffff",
                "strokeWidth": 1
            },
            "encoding": {
                "detail" : { "field" : "country"},
                "color" : {
                    "condition" : [
                        {"test": "datum.country == 'Malaysia'", "value":  "#1B4965"},
                        {"param": "Country_hover", "empty": false, "value": "#6A97BD" }
                    ],
                    "value" : "#AFC0C3"
                },
                "tooltip" : [
                    {"field": "country" , "type" : "nominal" , "title" : "Country"},
                    {"field": "year" , "type" : "ordinal" , "title" : "Year"},
                     {"field": "rank" , "type" : "quantitative" , "title" : "Rank that year"},
                      {"field": "visitors" , "type" : "quantitative" , "title" : "Visitors that year", "format" : ","}  
                ]
            }
        },
        {
            "transform": [
                {"filter" : "datum.year == 2025 && datum.country != 'Malaysia' "}
            ],
            "mark" : {
                "type": "text",
                "align" : "left",
                "dx" : 9 , 
                "fontSize" : 11, 
                "color" :"#557079"
            },
            "encoding": { "text" : {"field" : "country"}}
        },
        {
            "transform": [
                {"filter" : "datum.year == 2025 && datum.country == 'Malaysia' "}
            ],
            "mark" : {
                "type": "text",
                "align" : "left",
                "dx" : 9 , 
                "fontSize" : 12, 
                "color" :"#1B4965"
            },
            "encoding": { "text" : {"field" : "country"}}
        }, 
        {
            "transform": [
                {"filter" : "datum.year == 2025 && datum.country == 'Malaysia'"}
            ],
            "mark" : {
                "type": "text",
                "align" : "right",
                "baseline": "top",
                "dx" : -2 , 
                "dy" : 9,
                "lineHeight" : 14,
                "fontSize" : 12, 
                "fontWeight" : "bold",
                "color" :"#1B4965"
            },
            "encoding": { "text" : {"value" : ["Malaysia: 11th in 2025,", "56% of its 2019 visitors"]}}
        }, 
        {
            "transform": [
                {"filter" : "datum.year == 2015 && datum.country == 'Malaysia'"}
            ],
            "mark" : {
                "type": "text",
                "align" : "left",
                "baseline": "bottom",
                "dy" : -8,
                "fontSize" : 11, 
                "fontWeight" : "bold",
                "color" :"#1B4965"
            },
            "encoding": { "text" : {"value" : "7th in 2015"}}
        }
        
    ], 
    "config": {
        "view" : {"stroke": null},
        "axis": {"labelColor": "#557079", "titleColor": "#557079", "labelFontSize": 12, "titleFontSize": 12, "gridColor": "#E5EEEF", "domainColor": "#B7C7CA", "tickColor": "#B7C7CA"}
    }
}